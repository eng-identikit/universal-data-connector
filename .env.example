# Copy to .env and change the values.

# Broker entity store (PostgreSQL). Outside compose use BROKER_DB_HOST=localhost.
BROKER_DB_USER=udc
BROKER_DB_PASSWORD=change-me
BROKER_DB_NAME=udc_broker
# BROKER_DB_HOST=localhost
# BROKER_DB_PORT=5432
# BROKER_DB_URL=postgres://user:pass@host:5432/db   (overrides the variables above)

# JWT signing secret: long random string, identical on every instance.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BROKER_JWT_SECRET=

# Superadmin created on first start (ignored once users exist).
BROKER_ADMIN_USER=admin
BROKER_ADMIN_PASSWORD=

# BROKER_ACCESS_TOKEN_TTL=15m
# BROKER_REFRESH_TOKEN_TTL=7d

# Optional services. COMPOSE_PROFILES starts the bundled ones; the URLs tell the
# backend container what to use (bundled or external). Leave a URL empty to go
# without it. Outside compose the backend reads NATS_URL, BROKER_MQTT_URL and BROKER_REDIS_URL.
#   NATS: durable queues (at-least-once across restarts), cluster mode, NATS channel.
#         Without it: single instance, in-memory queues (pending notifications are
#         lost on restart).
#   MQTT: default broker for MQTT notification channels (a subscription can still
#         name its own broker in notify.url).
#   Redis: login sessions behind the JWTs (logout, revocation, active sessions) and
#         login attempt limits shared by all instances. Without it sessions are
#         kept in PostgreSQL and attempt limits are per instance.
COMPOSE_PROFILES=nats,mqtt,redis
COMPOSE_NATS_URL=nats://nats:4222
COMPOSE_MQTT_URL=mqtt://mqtt:1883
COMPOSE_REDIS_URL=redis://redis:6379
