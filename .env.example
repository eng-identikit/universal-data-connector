# Copy to .env and change the values.

# Broker entity store (PostgreSQL). Outside compose use BROKER_DB_HOST=localhost.
BROKER_DB_USER=udc
BROKER_DB_PASSWORD=change-me
BROKER_DB_NAME=udc_broker
# BROKER_DB_HOST=localhost
# BROKER_DB_PORT=5432
# BROKER_DB_URL=postgres://user:pass@host:5432/db   (overrides the variables above)

# JWT signing secret: long random string, identical on every instance.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BROKER_JWT_SECRET=

# Superadmin created on first start (ignored once users exist).
BROKER_ADMIN_USER=admin
BROKER_ADMIN_PASSWORD=

# BROKER_ACCESS_TOKEN_TTL=15m
# BROKER_REFRESH_TOKEN_TTL=7d
