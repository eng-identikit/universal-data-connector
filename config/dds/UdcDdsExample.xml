<?xml version="1.0"?>
<!--
  Example DDS configuration for the Universal Data Connector "dds" source type.

  It is an RTI XML-Based Application Creation file: it declares the data types,
  the domain with its topics, and a DomainParticipant with the DataReaders
  (connector "inputs") and DataWriters (connector "outputs").

  The wire protocol is standard DDS-RTPS, so these readers/writers interoperate
  with any DDS implementation (RTI Connext, eProsima Fast DDS, Eclipse Cyclone DDS,
  OpenDDS, ROS 2 nodes, ...) as long as the topic name, type and QoS match.
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="https://community.rti.com/schema/current/rti_dds_profiles.xsd">

  <qos_library name="UdcQosLibrary">
    <qos_profile name="Telemetry" base_name="BuiltinQosLib::Generic.StrictReliable" is_default_qos="true">
      <datareader_qos>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>10</depth>
        </history>
      </datareader_qos>
      <participant_qos>
        <participant_name>
          <name>Universal Data Connector</name>
        </participant_name>
      </participant_qos>
    </qos_profile>
  </qos_library>

  <types>
    <struct name="SensorData">
      <member name="sensor_id" type="string" stringMaxLength="64" key="true"/>
      <member name="temperature" type="float64"/>
      <member name="pressure" type="float64"/>
      <member name="running" type="boolean"/>
    </struct>
    <struct name="Setpoint">
      <member name="target_id" type="string" stringMaxLength="64" key="true"/>
      <member name="value" type="float64"/>
    </struct>
  </types>

  <domain_library name="UdcDomainLibrary">
    <domain name="UdcDomain" domain_id="0">
      <register_type name="SensorData" type_ref="SensorData"/>
      <register_type name="Setpoint" type_ref="Setpoint"/>
      <topic name="PlantSensorData" register_type_ref="SensorData"/>
      <topic name="PlantSetpoint" register_type_ref="Setpoint"/>
    </domain>
  </domain_library>

  <domain_participant_library name="UdcParticipantLibrary">
    <domain_participant name="UdcParticipant" domain_ref="UdcDomainLibrary::UdcDomain">
      <subscriber name="UdcSubscriber">
        <data_reader name="SensorReader" topic_ref="PlantSensorData"/>
      </subscriber>
      <publisher name="UdcPublisher">
        <data_writer name="SetpointWriter" topic_ref="PlantSetpoint"/>
      </publisher>
    </domain_participant>
  </domain_participant_library>
</dds>
